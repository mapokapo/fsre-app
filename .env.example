# Copy to `.env` and fill in values for local development.
# Expo loads EXPO_PUBLIC_* variables into the client bundle at build time.

# Timetable / subscription API (openapi-fetch client)
EXPO_PUBLIC_API_BASE_URL=https://example.com/api

# Firebase web config (push notifications, timetable subscription)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Google Gemini API key for the in-app chatbot.
# Client-side only today; a server proxy is planned for production hardening.
EXPO_PUBLIC_GOOGLE_GENAI_API_KEY=
