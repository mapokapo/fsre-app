  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": "prettier --write --ignore-path .gitignore",
    "**/*.{ts,tsx}": "eslint --fix",
    "**/!(*.test).{ts,tsx}": "tsc-files --noEmit nativewind-env.d.ts expo-env.d.ts"
