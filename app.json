{
  "expo": {
    "name": "FSRE App",
    "slug": "fsre-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "fsre",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "package": "com.fsre.mobileapp",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundImage": "./src/assets/images/icon_background.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.INTERNET"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e5a8a"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "visibility": "visible"
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "infoPlist": {
              "NSAppTransportSecurity": {
                "NSAllowsArbitraryLoads": true
              }
            }
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/01bc83d3-7af7-4a5f-8bc9-1b543abc5883"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "position": "relative",
        "visibility": "hidden",
        "behavior": "inset-swipe"
      },
      "eas": {
        "projectId": "01bc83d3-7af7-4a5f-8bc9-1b543abc5883"
      }
    },
    "owner": "fsresumba"
  }
}
