{
  "expo": {
    "name": "FSRE App",
    "slug": "fsre-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "fsre",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fsre.mobileapp",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["https", "http"],
        "UIBackgroundModes": ["remote-notification"]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.fsre.mobileapp",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#0A4977"
      },
      "permissions": ["android.permission.INTERNET"],
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "visibility": "hidden",
          "behavior": "inset-swipe"
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "infoPlist": {
              "NSAppTransportSecurity": {
                "NSAllowsArbitraryLoads": true
              }
            }
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/621ebfd2-1f62-49a6-a434-7e45176170ad"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "position": "relative",
        "visibility": "hidden",
        "behavior": "inset-swipe"
      },
      "eas": {
        "projectId": "01bc83d3-7af7-4a5f-8bc9-1b543abc5883"
      }
    },
    "owner": "fsresumba"
  }
}
